/*
 * LilyGo T-Display SF32 (SF32LB525UC6)
 *
 * Derived from boards/sifli/sf32lb52_devkit_lcd (Copyright (c) 2025 Core Devices LLC)
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;

#include <sifli/sf32lb52x.dtsi>
#include <sifli/sf32lb52x-ram012.dtsi>
#include <zephyr/dt-bindings/dma/sf32lb52x-dma.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include "t_display_sf32-pinctrl.dtsi"

/ {
	model = "LilyGo T-Display SF32";
	compatible = "lilygo,t-display-sf32";

	chosen {
		zephyr,flash = &w25q128;
		zephyr,flash-controller = &mpi2;
		zephyr,code-partition = &code;
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,crc = &crc;
		zephyr,entropy = &trng;
		zephyr,bt-hci = &mailbox;
	};

	/* The three side buttons, silkscreened A/B/C. Pins and polarity follow
	 * LilyGo's pin map and button example; B is the odd one out, wired
	 * active-high with a pull-down.
	 */
	buttons {
		compatible = "gpio-keys";

		key_a: key_a {
			label = "A";
			gpios = <&gpioa_32_44 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			zephyr,code = <INPUT_KEY_A>;
		};

		key_b: key_b {
			label = "B";
			gpios = <&gpioa_32_44 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_B>;
		};

		key_c: key_c {
			label = "C";
			gpios = <&gpioa_32_44 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_C>;
		};
	};

	soc {
		/* Lives here rather than under &mpi1, which declares
		 * #size-cells = <0> for its flash children.
		 */
		psram: memory@60000000 {
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0x60000000 DT_SIZE_M(8)>;
			device_type = "memory";
			zephyr,memory-region = "PSRAM";
			zephyr,memory-attr = <DT_MEM_ARM(ATTR_MPU_RAM)>;
		};
	};

	aliases {
		sw0 = &key_c;
		sw1 = &key_a;
		sw2 = &key_b;
		rtc = &rtc;
		watchdog0 = &wdt;
	};
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(240)>;
};

&hxt48 {
	status = "okay";
};

&rcc_clk {
	status = "okay";

	sifli,hdiv = <1>;
	sifli,pdiv1 = <1>;
	sifli,pdiv2 = <6>;
	sifli,sys-clk-src = "dll1";

	dll1 {
		status = "okay";
		clock-frequency = <DT_FREQ_M(240)>;
	};
};

&rcc_rst {
	status = "okay";
};

&gpioa_00_31 {
	status = "okay";
};

&gpioa_32_44 {
	status = "okay";
};

&dmac {
	status = "okay";
};

&pinctrl {
	status = "okay";
};

/* W25Q128JV, 16 MB. The ptable/code split matches the SiFli bootloader's
 * expectations; the tail is a LittleFS storage partition for NodeDB/config.
 */
&mpi2 {
	compatible = "sifli,sf32lb-mpi-qspi-nor";
	dmas = <&dmac 0 SF32LB52X_DMA_REQ_MPI2 SF32LB_DMA_PL_MEDIUM>;
	sifli,psclr = <0>;
	sifli,lines = <4>;
	status = "okay";

	/* The MPI controller is the flash device; this child only carries the
	 * chip's parameters. Tagging it soc-nv-flash as well makes flash_map
	 * resolve partitions to the controller instead of to this node, which
	 * has no driver of its own.
	 */
	w25q128: flash@0 {
		compatible = "jedec,qspi-nor", "soc-nv-flash";
		reg = <0x0>;
		size = <DT_SIZE_M(128)>;
		quad-enable-requirements = "S2B1v1";

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			ptable: partition@0 {
				label = "ptable";
				reg = <0x0 DT_SIZE_K(64)>;
			};

			code: partition@10000 {
				label = "code";
				reg = <0x10000 DT_SIZE_K(8128)>;
			};

			storage_partition: partition@800000 {
				label = "storage";
				reg = <0x800000 DT_SIZE_K(8192)>;
			};
		};
	};
};

/* MPI1 drives the 8 MB of in-package OPI PSRAM; the memory itself appears at
 * its own aperture, not MPI1's NOR window. Brought up by
 * zephyr/sifli/drivers/psram_sf32lb.c, since Zephyr's SiFli support describes
 * only QSPI NOR on the MPI controllers.
 */
&mpi1 {
	compatible = "sifli,sf32lb-mpi-psram";
	status = "okay";
};

&usart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&usart1_default>;
	pinctrl-names = "default";
};

&usart2 {
	status = "okay";
	current-speed = <9600>;
	pinctrl-0 = <&usart2_default>;
	pinctrl-names = "default";
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
};

/* SX1262 CS (PA29) is driven by RadioLib through the Arduino shim, so only the
 * TF card's CS (PA43) is registered here.
 */
&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa_32_44 11 GPIO_ACTIVE_LOW>;

	/* TF slot. Shares the bus with the radio, so every card access takes the
	 * same SPI lock RadioLib does.
	 */
	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <12000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/* The CO5300 is driven through the vendor LCDC HAL from
 * src/platform/sifli/LGFX_Bus_LCDC.cpp, because Zephyr's mipi_dbi driver has
 * no quad mode. Both nodes stay disabled so that driver does not claim the
 * controller; the pin state and clock are still described here.
 */
&lcdc {
	lcdc_dbi: mipi-dbi {
		pinctrl-0 = <&lcdc_qspi_default>;
		pinctrl-names = "default";
	};
};

&wdt {
	status = "okay";
};

&rtc {
	status = "okay";
};

&crc {
	status = "okay";
};

&crypto {
	status = "okay";
};

&trng {
	status = "okay";
};

&mailbox {
	status = "okay";
};
